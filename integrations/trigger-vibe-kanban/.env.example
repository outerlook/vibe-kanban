# Trigger.dev target
TRIGGER_PROJECT_REF=local-KiUk
TRIGGER_API_URL=https://trigger.home.arpa

# Optional: use a specific local CLI profile instead of the default logged-in profile
# TRIGGER_PROFILE=home-trigger

# Optional: if set, deploy/dev can run without relying on local CLI login state
# TRIGGER_ACCESS_TOKEN=tr_pat_xxx

# Use the DEV secret key from the Trigger.dev dashboard when running local dev
TRIGGER_SECRET_KEY=tr_dev_xxx

# Vibe Kanban API the workflows talk to
# Adjust the port to your local backend port
VK_API_BASE_URL=http://127.0.0.1:3001

# MQTT broker used for orchestration events
VK_MQTT_BROKER_URL=mqtt://127.0.0.1:1883
VK_MQTT_TOPIC_NAMESPACE=vk/orchestration

# Routing mode:
# - direct: run orchestration logic directly in the mqtt bridge process
# - trigger: enqueue runs in Trigger.dev
VK_MQTT_ROUTER_MODE=trigger

# Optional MQTT auth
# VK_MQTT_USERNAME=
# VK_MQTT_PASSWORD=
# VK_MQTT_CLIENT_ID=

# Optional API auth for the Vibe Kanban backend
# VK_API_AUTH_MODE=none
# VK_API_TOKEN=
# VK_API_HEADER_NAME=
# VK_API_HEADER_PREFIX=

# Optional CodeRabbit polling
# CODERABBIT_POLL_CRON=*/5 * * * *
# CODERABBIT_POLL_SCOPE_KEY=global
# GITHUB_TOKEN=
# GITHUB_GRAPHQL_URL=
