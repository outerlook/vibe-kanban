# syntax=docker/dockerfile:1.6

ARG N8N_VERSION=2.16.0

FROM node:24-alpine AS vk-node-builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /workspace

RUN corepack enable && pnpm config set store-dir /pnpm/store

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY integrations/n8n-nodes-vibe-kanban/package.json integrations/n8n-nodes-vibe-kanban/package.json

RUN --mount=type=cache,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter n8n-nodes-vibe-kanban...

COPY integrations/n8n-nodes-vibe-kanban integrations/n8n-nodes-vibe-kanban
COPY shared/types.ts shared/types.ts

RUN --mount=type=cache,target=/pnpm/store \
    pnpm --dir integrations/n8n-nodes-vibe-kanban build \
 && pnpm --dir integrations/n8n-nodes-vibe-kanban pack --out /tmp/n8n-nodes-vibe-kanban-%v.tgz

FROM docker.n8n.io/n8nio/n8n:${N8N_VERSION}

USER root

RUN mkdir -p /opt/n8n-custom

COPY --from=vk-node-builder /tmp/n8n-nodes-vibe-kanban-*.tgz /tmp/

RUN cd /opt/n8n-custom \
 && npm install --omit=dev /tmp/n8n-nodes-vibe-kanban-*.tgz \
 && rm -f /tmp/n8n-nodes-vibe-kanban-*.tgz \
 && chown -R node:node /opt/n8n-custom

# Keep custom extensions outside /home/node/.n8n so the runtime volume does not mask them.
# n8n scans directories that contain installed custom node packages, not the package
# directory itself.
ENV N8N_CUSTOM_EXTENSIONS=/opt/n8n-custom/node_modules

USER node
