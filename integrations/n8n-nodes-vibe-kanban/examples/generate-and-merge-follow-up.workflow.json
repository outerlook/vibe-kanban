{
  "name": "VK Generate And Merge Follow Up",
  "nodes": [
    {
      "parameters": {
        "content": "## Production Workflow\\nQueues a generate-and-merge follow-up after an approval is resolved in Vibe Kanban.\\n\\nThis workflow is intended to be used in production. It only reacts to approved approvals with workspace scope, then resolves the target repo and enqueues the merge follow-up.",
        "height": 260,
        "width": 460,
        "color": 1
      },
      "id": "generate-and-merge-note",
      "name": "Workflow Description",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        80
      ]
    },
    {
      "parameters": {
        "eventTypes": [
          "approval_resolved"
        ],
        "schemaVersion": "vk_n8n_orchestration_v1"
      },
      "id": "vk-trigger",
      "name": "VK Trigger",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanTrigger",
      "typeVersion": 1,
      "position": [
        220,
        260
      ],
      "credentials": {
        "vibeKanbanMqtt": {
          "name": "Local VK MQTT"
        }
      }
    },
    {
      "parameters": {
        "resource": "approval",
        "approvalId": "={{$json.refs.approvalContext.approvalId}}"
      },
      "id": "vk-read-approval",
      "name": "Read Approval Context",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanRead",
      "typeVersion": 1,
      "position": [
        500,
        260
      ],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "if ($json.approval?.status !== 'approved' || !$json.workspace?.id) {\n  return [];\n}\n\nreturn [{ json: $json }];"
      },
      "id": "keep-approved-workspace-approvals",
      "name": "Keep Approved Workspace Approvals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        260
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "workspace-id",
              "name": "workspaceId",
              "type": "string",
              "value": "={{$json.workspace.id}}"
            },
            {
              "id": "repo-id",
              "name": "repoId",
              "type": "string",
              "value": "={{$env.VK_DEFAULT_GENERATE_AND_MERGE_REPO_ID}}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-merge-payload",
      "name": "Resolve Merge Inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1060,
        260
      ]
    },
    {
      "parameters": {
        "resource": "workspace",
        "operation": "queueGenerateAndMerge",
        "workspaceId": "={{$json.workspaceId}}",
        "repoId": "={{$json.repoId}}"
      },
      "id": "vk-queue-merge",
      "name": "Queue Generate And Merge",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanAction",
      "typeVersion": 1,
      "position": [
        1340,
        260
      ],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    }
  ],
  "connections": {
    "VK Trigger": {
      "main": [
        [
          {
            "node": "Read Approval Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Approval Context": {
      "main": [
        [
          {
            "node": "Keep Approved Workspace Approvals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Approved Workspace Approvals": {
      "main": [
        [
          {
            "node": "Resolve Merge Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve Merge Inputs": {
      "main": [
        [
          {
            "node": "Queue Generate And Merge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
