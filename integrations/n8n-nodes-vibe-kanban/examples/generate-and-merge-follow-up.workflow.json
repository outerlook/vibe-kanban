{
  "name": "VK Generate And Merge Follow Up",
  "nodes": [
    {
      "parameters": {
        "eventTypes": [
          "approval_resolved"
        ],
        "schemaVersion": "vk_n8n_orchestration_v1"
      },
      "id": "vk-trigger",
      "name": "VK Trigger",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanTrigger",
      "typeVersion": 1,
      "position": [
        240,
        260
      ],
      "credentials": {
        "vibeKanbanMqtt": {
          "name": "Local VK MQTT"
        }
      }
    },
    {
      "parameters": {
        "resource": "approval",
        "approvalId": "={{$json.refs.approvalContext.approvalId}}"
      },
      "id": "vk-read-approval",
      "name": "Read Approval Context",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanRead",
      "typeVersion": 1,
      "position": [
        520,
        260
      ],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "workspace-id",
              "name": "workspaceId",
              "type": "string",
              "value": "={{$json.workspace.id}}"
            },
            {
              "id": "repo-id",
              "name": "repoId",
              "type": "string",
              "value": "={{$env.VK_DEFAULT_GENERATE_AND_MERGE_REPO_ID}}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-merge-payload",
      "name": "Resolve Merge Inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        260
      ]
    },
    {
      "parameters": {
        "resource": "workspace",
        "operation": "queueGenerateAndMerge",
        "workspaceId": "={{$json.workspaceId}}",
        "repoId": "={{$json.repoId}}"
      },
      "id": "vk-queue-merge",
      "name": "Queue Generate And Merge",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanAction",
      "typeVersion": 1,
      "position": [
        1080,
        260
      ],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    }
  ],
  "connections": {
    "VK Trigger": {
      "main": [
        [
          {
            "node": "Read Approval Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Approval Context": {
      "main": [
        [
          {
            "node": "Resolve Merge Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve Merge Inputs": {
      "main": [
        [
          {
            "node": "Queue Generate And Merge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
