{
  "name": "VK Review Gate",
  "nodes": [
    {
      "parameters": {
        "content": "## Production Workflow\\nStarts the external review gate when a task enters `in_review`. It reads the task and latest coding execution context from Vibe Kanban, builds the full reviewer prompt, and starts a dedicated reviewer conversation using the configured VK default executor unless explicitly overridden.\\n\\nThis workflow is intended to be used in production. Review policy lives in n8n, not in VK. VK only provides the task, workspace, and execution building blocks plus the reviewer execution itself.",
        "height": 280,
        "width": 500,
        "color": 1
      },
      "id": "review-gate-note",
      "name": "Workflow Description",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, 80]
    },
    {
      "parameters": {
        "eventTypes": ["task_status_changed"],
        "schemaVersion": "vk_n8n_orchestration_v1"
      },
      "id": "vk-trigger",
      "name": "VK Trigger",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanTrigger",
      "typeVersion": 1,
      "position": [220, 300],
      "credentials": {
        "vibeKanbanMqtt": {
          "name": "Local VK MQTT"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "if (($json.payload?.status || '') !== 'in_review') {\\n  return [];\\n}\\n\\nreturn [{ json: $json }];"
      },
      "id": "keep-in-review-tasks",
      "name": "Keep Tasks In Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "resource": "task",
        "taskId": "={{$json.refs.taskContext.taskId}}"
      },
      "id": "vk-read-task",
      "name": "Read Task Context",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanRead",
      "typeVersion": 1,
      "position": [780, 300],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\\nconst reviewGate = staticData.reviewGate || {};\\nreviewGate.pendingByReviewExecutionProcessId ??= {};\\nreviewGate.pendingBySourceExecutionId ??= {};\\nreviewGate.completedBySourceExecutionId ??= {};\\nstaticData.reviewGate = reviewGate;\\n\\nconst task = $json.task;\\nconst workspace = $json.latest_workspace;\\nconst latestCodingExecution = $json.latest_coding_execution;\\n\\nif (!task?.id || !workspace?.id || !latestCodingExecution?.id) {\\n  return [];\\n}\\n\\nif ($json.queue_state?.merge_queue?.id) {\\n  return [];\\n}\\n\\nif (reviewGate.pendingBySourceExecutionId[latestCodingExecution.id]) {\\n  return [];\\n}\\n\\nif (reviewGate.completedBySourceExecutionId[latestCodingExecution.id]) {\\n  return [];\\n}\\n\\nif ($json.latest_review_attention?.execution_process_id === latestCodingExecution.id) {\\n  return [];\\n}\\n\\nreturn [{\\n  json: {\\n    projectId: task.project_id,\\n    taskId: task.id,\\n    taskTitle: task.title,\\n    taskDescription: task.description || '',\\n    workspaceId: workspace.id,\\n    worktreePath: workspace.agent_working_dir || '',\\n    worktreeBranch: workspace.branch || '',\\n    sourceExecutionProcessId: latestCodingExecution.id,\\n  },\\n}];"
      },
      "id": "keep-review-candidates",
      "name": "Keep Review Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1060, 300]
    },
    {
      "parameters": {
        "resource": "execution",
        "executionProcessId": "={{$json.sourceExecutionProcessId}}"
      },
      "id": "vk-read-execution",
      "name": "Read Latest Coding Execution Context",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanRead",
      "typeVersion": 1,
      "position": [1360, 300],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "project-id",
              "name": "projectId",
              "type": "string",
              "value": "={{$('Keep Review Candidates').item.json.projectId}}"
            },
            {
              "id": "task-id",
              "name": "taskId",
              "type": "string",
              "value": "={{$('Keep Review Candidates').item.json.taskId}}"
            },
            {
              "id": "workspace-id",
              "name": "workspaceId",
              "type": "string",
              "value": "={{$('Keep Review Candidates').item.json.workspaceId}}"
            },
            {
              "id": "source-execution-id",
              "name": "sourceExecutionProcessId",
              "type": "string",
              "value": "={{$('Keep Review Candidates').item.json.sourceExecutionProcessId}}"
            },
            {
              "id": "worktree-path",
              "name": "worktreePath",
              "type": "string",
              "value": "={{$('Keep Review Candidates').item.json.worktreePath}}"
            },
            {
              "id": "worktree-branch",
              "name": "worktreeBranch",
              "type": "string",
              "value": "={{$('Keep Review Candidates').item.json.worktreeBranch}}"
            },
            {
              "id": "review-title",
              "name": "reviewConversationTitle",
              "type": "string",
              "value": "={{`Review gate: ${$('Keep Review Candidates').item.json.taskTitle}`}}"
            },
            {
              "id": "repo-ids-json",
              "name": "repoIdsJson",
              "type": "string",
              "value": "={{JSON.stringify(($json.repo_states || []).map((state) => state.repo_id))}}"
            },
            {
              "id": "initial-message",
              "name": "initialMessage",
              "type": "string",
              "value": "={{`You are the final reviewer for a completed Vibe Kanban task.\\n\\nReview objective:\\n- Approve only if the work is ready to merge into the task group's base branch.\\n- Reject if the work is incomplete, incorrect, risky, blocked, or does not satisfy the original task.\\n- If you reject, explain the key reason briefly and concretely.\\n\\nInspect the worktree when useful, but always ground your verdict in the task and execution context below.\\n\\n## Original Task\\nTitle: ${$('Keep Review Candidates').item.json.taskTitle}\\nDescription: ${$('Keep Review Candidates').item.json.taskDescription || '(no description)'}\\n\\n## Task Orchestration Context\\n${JSON.stringify($('Read Task Context').item.json, null, 2)}\\n\\n## Latest Coding Execution Context\\n${JSON.stringify($json, null, 2)}\\n\\nReturn only JSON with this shape:\\n{\"approved\": true, \"reasoning\": \"brief explanation\"}\\n\\nRules:\\n- \\\"approved\\\" must be true only when the work is actually ready to merge.\\n- \\\"reasoning\\\" must always be present and concise.\\n- Do not wrap the JSON in markdown fences.`}}"
            }
          ]
        },
        "options": {}
      },
      "id": "build-review-input",
      "name": "Build Review Conversation Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1660, 300]
    },
    {
      "parameters": {
        "resource": "conversation",
        "operation": "createConversation",
        "projectId": "={{$json.projectId}}",
        "title": "={{$json.reviewConversationTitle}}",
        "initialMessage": "={{$json.initialMessage}}",
        "executor": "",
        "executorVariant": "",
        "worktreePath": "={{$json.worktreePath}}",
        "worktreeBranch": "={{$json.worktreeBranch}}"
      },
      "id": "vk-create-review-conversation",
      "name": "Start Reviewer Conversation",
      "type": "n8n-nodes-vibe-kanban.vibeKanbanAction",
      "typeVersion": 1,
      "position": [1970, 300],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "project-id",
              "name": "projectId",
              "type": "string",
              "value": "={{$('Build Review Conversation Input').item.json.projectId}}"
            },
            {
              "id": "task-id",
              "name": "taskId",
              "type": "string",
              "value": "={{$('Build Review Conversation Input').item.json.taskId}}"
            },
            {
              "id": "workspace-id",
              "name": "workspaceId",
              "type": "string",
              "value": "={{$('Build Review Conversation Input').item.json.workspaceId}}"
            },
            {
              "id": "source-execution-id",
              "name": "sourceExecutionProcessId",
              "type": "string",
              "value": "={{$('Build Review Conversation Input').item.json.sourceExecutionProcessId}}"
            },
            {
              "id": "repo-ids-json",
              "name": "repoIdsJson",
              "type": "string",
              "value": "={{$('Build Review Conversation Input').item.json.repoIdsJson}}"
            },
            {
              "id": "conversation-id",
              "name": "conversationId",
              "type": "string",
              "value": "={{$json.conversation.id}}"
            },
            {
              "id": "review-execution-id",
              "name": "reviewExecutionProcessId",
              "type": "string",
              "value": "={{$json.executionProcessId}}"
            }
          ]
        },
        "options": {}
      },
      "id": "build-review-registration",
      "name": "Build Review Registration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2280, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\\nconst reviewGate = staticData.reviewGate || {};\\nreviewGate.pendingByReviewExecutionProcessId ??= {};\\nreviewGate.pendingBySourceExecutionId ??= {};\\nreviewGate.completedBySourceExecutionId ??= {};\\nstaticData.reviewGate = reviewGate;\\n\\nif (!$json.reviewExecutionProcessId || !$json.sourceExecutionProcessId) {\\n  throw new Error('Missing review execution registration identifiers');\\n}\\n\\nreviewGate.pendingByReviewExecutionProcessId[$json.reviewExecutionProcessId] = {\\n  conversationId: $json.conversationId,\\n  projectId: $json.projectId,\\n  taskId: $json.taskId,\\n  workspaceId: $json.workspaceId,\\n  sourceExecutionProcessId: $json.sourceExecutionProcessId,\\n  repoIdsJson: $json.repoIdsJson,\\n  createdAt: new Date().toISOString(),\\n};\\nreviewGate.pendingBySourceExecutionId[$json.sourceExecutionProcessId] = $json.reviewExecutionProcessId;\\n\\nreturn [{ json: $json }];"
      },
      "id": "register-review-conversation",
      "name": "Register Review Conversation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2570, 300]
    }
  ],
  "connections": {
    "VK Trigger": {
      "main": [
        [
          {
            "node": "Keep Tasks In Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Tasks In Review": {
      "main": [
        [
          {
            "node": "Read Task Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Task Context": {
      "main": [
        [
          {
            "node": "Keep Review Candidates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Review Candidates": {
      "main": [
        [
          {
            "node": "Read Latest Coding Execution Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Latest Coding Execution Context": {
      "main": [
        [
          {
            "node": "Build Review Conversation Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Review Conversation Input": {
      "main": [
        [
          {
            "node": "Start Reviewer Conversation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Reviewer Conversation": {
      "main": [
        [
          {
            "node": "Build Review Registration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Review Registration": {
      "main": [
        [
          {
            "node": "Register Review Conversation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
