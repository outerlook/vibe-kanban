{
  "name": "VK Feedback Collection",
  "nodes": [
    {
      "parameters": {
        "content": "## Production Workflow\nCreates feedback records after task-backed executions finish in Vibe Kanban.\n\nThis workflow is intended to be used in production. It skips conversation-only executions because feedback records require both task and workspace scope.",
        "height": 240,
        "width": 440,
        "color": 1
      },
      "id": "feedback-collection-note",
      "name": "Workflow Description",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        100
      ]
    },
    {
      "parameters": {
        "eventTypes": [
          "execution_completed"
        ],
        "schemaVersion": "vk_orchestration_v1"
      },
      "id": "vk-trigger",
      "name": "VK Trigger",
      "type": "CUSTOM.vibeKanbanTrigger",
      "typeVersion": 1,
      "position": [
        220,
        280
      ],
      "credentials": {
        "vibeKanbanMqtt": {
          "name": "Local VK MQTT"
        }
      }
    },
    {
      "parameters": {
        "resource": "execution",
        "executionProcessId": "={{$json.refs.executionContext.executionProcessId}}"
      },
      "id": "vk-read-execution",
      "name": "Read Execution Context",
      "type": "CUSTOM.vibeKanbanRead",
      "typeVersion": 1,
      "position": [
        500,
        280
      ],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input\n  .all()\n  .filter((item) => item.json.scope?.task?.id && item.json.scope?.workspace?.id);"
      },
      "id": "keep-task-workspace-executions",
      "name": "Keep Task Workspace Executions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        280
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "task-id",
              "name": "taskId",
              "type": "string",
              "value": "={{$json.scope.task.id}}"
            },
            {
              "id": "workspace-id",
              "name": "workspaceId",
              "type": "string",
              "value": "={{$json.scope.workspace.id}}"
            },
            {
              "id": "execution-id",
              "name": "executionProcessId",
              "type": "string",
              "value": "={{$json.execution.id}}"
            },
            {
              "id": "feedback-json",
              "name": "feedbackJson",
              "type": "string",
              "value": "={{JSON.stringify({summary: $json.execution.status, review_attention: $json.review_attention, feedback: $json.feedback})}}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-feedback",
      "name": "Build Feedback Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1060,
        280
      ]
    },
    {
      "parameters": {
        "resource": "feedback",
        "operation": "createFeedback",
        "taskId": "={{$json.taskId}}",
        "workspaceId": "={{$json.workspaceId}}",
        "executionProcessId": "={{$json.executionProcessId}}",
        "feedbackJson": "={{$json.feedbackJson}}"
      },
      "id": "vk-create-feedback",
      "name": "Create Feedback",
      "type": "CUSTOM.vibeKanbanAction",
      "typeVersion": 1,
      "position": [
        1350,
        280
      ],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    }
  ],
  "connections": {
    "VK Trigger": {
      "main": [
        [
          {
            "node": "Read Execution Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Execution Context": {
      "main": [
        [
          {
            "node": "Keep Task Workspace Executions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Task Workspace Executions": {
      "main": [
        [
          {
            "node": "Build Feedback Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Feedback Payload": {
      "main": [
        [
          {
            "node": "Create Feedback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
