{
  "name": "VK Autopilot Continuation",
  "nodes": [
    {
      "parameters": {
        "content": "## Production Workflow\nWhen a task is marked `done`, read the completed task orchestration context, inspect its raw `dependents`, and let the workflow decide which dependents are runnable.\n\nA dependent is started only when it is still `todo`, not blocked, not already running, and not already queued. Each dependent execution uses VK task-level building blocks: `latest_or_create` for workspace reuse and the configured VK default executor unless the workflow explicitly overrides it, with task-group defaults for repository branches.",
        "height": 240,
        "width": 460,
        "color": 1
      },
      "id": "autopilot-continuation-note",
      "name": "Workflow Description",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        100
      ]
    },
    {
      "parameters": {
        "eventTypes": [
          "task_status_changed"
        ],
        "schemaVersion": "vk_orchestration_v1"
      },
      "id": "vk-trigger",
      "name": "VK Trigger",
      "type": "CUSTOM.vibeKanbanTrigger",
      "typeVersion": 1,
      "position": [
        220,
        280
      ],
      "credentials": {
        "vibeKanbanMqtt": {
          "name": "Local VK MQTT"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input\n  .all()\n  .filter((item) => (item.json.payload?.status || '') === 'done');"
      },
      "id": "keep-done-tasks",
      "name": "Keep Done Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        280
      ]
    },
    {
      "parameters": {
        "resource": "task",
        "taskId": "={{$json.refs.taskContext.taskId}}"
      },
      "id": "vk-read-task",
      "name": "Read Task Context",
      "type": "CUSTOM.vibeKanbanRead",
      "typeVersion": 1,
      "position": [
        780,
        280
      ],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().flatMap((item) => {\n  const dependents = item.json.dependency_context?.dependents ?? [];\n\n  return dependents\n    .filter((task) => (\n      task.status === 'todo' &&\n      !task.is_blocked &&\n      !task.has_in_progress_attempt &&\n      !task.is_queued\n    ))\n    .map((dependentTask) => ({\n      json: {\n        completedTask: item.json.task,\n        dependentTask,\n      },\n    }));\n});"
      },
      "id": "select-runnable-dependents",
      "name": "Select Runnable Dependents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        280
      ]
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "startTaskExecution",
        "taskId": "={{$json.dependentTask.id}}",
        "workspaceStrategy": "latest_or_create",
        "executorStrategy": "default",
        "executor": "",
        "executorVariant": "",
        "repoSelection": "taskGroupDefault"
      },
      "id": "vk-start-execution",
      "name": "Start Task Execution",
      "type": "CUSTOM.vibeKanbanAction",
      "typeVersion": 1,
      "position": [
        1340,
        280
      ],
      "credentials": {
        "vibeKanbanApi": {
          "name": "Local VK API"
        }
      }
    }
  ],
  "connections": {
    "VK Trigger": {
      "main": [
        [
          {
            "node": "Keep Done Tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Done Tasks": {
      "main": [
        [
          {
            "node": "Read Task Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Task Context": {
      "main": [
        [
          {
            "node": "Select Runnable Dependents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select Runnable Dependents": {
      "main": [
        [
          {
            "node": "Start Task Execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
